# Copy to .env - it is loaded from this directory when the app starts here
# (./mvnw spring-boot:run or pnpm dev). Real environment variables win.

# Postgres connection string. Omit to use the docker-compose database on
# localhost:5432. Hosted example (Neon / Supabase / RDS):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/excalidraw"

# Secret used to sign JWTs, at least 32 bytes. Generate one with:
#   openssl rand -hex 48
# Keeping the value the Node backend used keeps existing sessions valid.
# Optional in development; required when the prod profile is active.
JWT_SECRET=""

# How long issued tokens stay valid: 7d, 12h, 30m ...
JWT_EXPIRES_IN="7d"

# HTTP and WebSocket port. Most hosts inject PORT automatically.
PORT=3001

# Comma separated browser origins allowed to call the API and open sockets.
# Use "*" for local development only.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"
