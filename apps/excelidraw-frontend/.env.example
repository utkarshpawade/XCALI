# These are inlined at build time, so they must be set before `next build`.
NEXT_PUBLIC_HTTP_BACKEND="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001/ws"

# In production use the public HTTPS/WSS URLs of your deployed backends, e.g.
# NEXT_PUBLIC_HTTP_BACKEND="https://api.example.com"
# NEXT_PUBLIC_WS_URL="wss://api.example.com/ws"
